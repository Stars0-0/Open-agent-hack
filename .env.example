# Zetaris (data layer)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift (primary AI provider). Runtime URL and token are in Nightshift's Console.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto

# true = read sample CSV inputs from data/sample instead of Zetaris (models still go through Nightshift)
SAMPLE_MODE=false
